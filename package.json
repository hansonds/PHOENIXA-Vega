{
  "name": "phoenixa-vega",
  "version": "1.0.0",
  "private": true,
  "description": "PHOENIXA, a cinematic Jellyfin client for Fire TV devices running Vega OS",
  "author": "Hanson (phoenicx.org)",
  "scripts": {
    "build:app": "npm-run-all build:release",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:release": "react-native build-vega --build-type Release",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "start": "react-native start"
  },
  "overrides": {
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "dependencies": {
    "@amazon-devices/react-native-async-storage__async-storage": "2.1.9000000002",
    "@amazon-devices/react-native-kepler": "4.0.2",
    "@amazon-devices/react-native-w3cmedia": "~2.3.5",
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "0.22.14",
    "@react-native-community/cli": "20.2.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@types/react": "^19.2.0",
    "npm-run-all2": "9.0.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "kepler": {
    "projectType": "application",
    "appName": "PHOENIXA",
    "targets": [
      "tv"
    ]
  }
}
